{
  "expo": {
    "name": "Juicy",
    "slug": "juicy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sip4me.juicy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#9A4E00",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sip4me.juicy"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Juicy uses the camera so you can snap what you eat. Photos stay private until you post.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-sqlite"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e7cdee6b-0639-4d5a-8dc6-02c82827c484"
    },
    "extra": {
      "eas": {
        "projectId": "e7cdee6b-0639-4d5a-8dc6-02c82827c484"
      }
    }
  }
}
